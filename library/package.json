{
  "name": "zkpjwt-core",
  "version": "0.1.1",
  "description": "Zero-Knowledge Proof access control for Web3 - Privacy-preserving wallet allowlists using ZK proofs and Merkle trees on Arbitrum Stylus",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist node_modules"
  },
  "keywords": [
    "zkp",
    "zero-knowledge",
    "groth16",
    "merkle-tree",
    "poseidon",
    "circom",
    "snarkjs",
    "arbitrum",
    "stylus",
    "privacy"
  ],
  "author": {
    "name": "Cristobal Valencia",
    "email": "cristobalvalencia3002@gmail.com",
    "url": "https://github.com/DevCristobalvc"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevCristobalvc/zkp-jwt.git",
    "directory": "library"
  },
  "bugs": {
    "url": "https://github.com/DevCristobalvc/zkp-jwt/issues"
  },
  "homepage": "https://zkpjwt.vercel.app",
  "dependencies": {
    "circomlibjs": "^0.1.7",
    "ethers": "^6.13.0",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vite-plugin-dts": "^3.9.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "directories": {
    "test": "tests"
  }
}
